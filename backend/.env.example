# Environment Configuration for TraceGuard AI Backend
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application
APP_NAME="TraceGuard AI"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite for immediate out-of-the-box development:
DATABASE_URL=sqlite:///./traceguard.db
# PostgreSQL for production/Docker:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/traceguard

# Security and Authentication
# In production, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-traceguard-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default API Key for Chrome Extension Development
EXTENSION_API_KEY=tg_ext_dev_secret_key_987654321

# CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Threat Intelligence (Google Safe Browsing or Mock)
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=mock
GOOGLE_SAFE_BROWSING_API_KEY=
THREAT_INTEL_CACHE_HOURS=24

# TigerGraph Configuration (Graph Database)
TIGERGRAPH_ENABLED=false
TIGERGRAPH_USE_MOCK=true
TIGERGRAPH_HOST=http://127.0.0.1:9000
TIGERGRAPH_GRAPHNAME=TraceGuardGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=

# AI Investigation Agent Configuration
LLM_ENABLED=false
LLM_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Data Retention and Rate Limiting
DATA_RETENTION_DAYS=90
RATE_LIMIT_PER_MINUTE=120

